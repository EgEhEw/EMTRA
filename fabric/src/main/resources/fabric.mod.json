{
  "schemaVersion": 1,
  "id": "emtra",
  "version": "${version}",
  "name": "EMTRA",
  "description": "EMTRA (EgEhEs MTR Addon) - Adds dynamic alternate platform routing, real-time PIDS arrival tracking, and intelligent train dispatching to Minecraft Transit Railway.",
  "authors": [
    "EgEhEw"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.egehew.emtra.fabric.EmtraFabric"
    ],
    "modmenu": [
      "com.egehew.emtra.fabric.EmtraModMenu"
    ]
  },
  "mixins": [
    "emtra.mixins.json",
    {
      "config": "emtra.render.mixins.json",
      "environment": "client"
    },
    {
      "config": "emtra.fabric.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.14.0",
    "minecraft": ">=1.20.1 <=1.20.4",
    "fabric-api": "*",
    "mtr": ">=4.0.0"
  },
  "suggests": {
    "modmenu": "*"
  }
}
